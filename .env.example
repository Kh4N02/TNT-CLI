# UK Webshare proxy — host:port:username:password
TNT_PROXY=37.44.218.117:5800:user:pass

# Optional Clash tunnel — used for N_m3u8DL downloads. HBO Max API uses TNT_PROXY first (UK Webshare).
TNT_PROXY_TUNNEL=127.0.0.1:7897

# Force API via Clash instead of TNT_PROXY (only if you need it)
# TNT_API_VIA_TUNNEL=1

# Subscribed login for playback (shows a code — link at play.hbomax.com/link)
# TNT_DEVICE_LOGIN=1

# HBO Max UK login (https://play.hbomax.com)
TNT_EMAIL=your@email.com
# Quote passwords that contain # (otherwise .env treats # as a comment)
TNT_PASSWORD="yourpassword"

# Optional: show Chrome during login
# TNT_BROWSER_HEADLESS=0

# Optional paths
# TNT_NM3U8DL=D:\Tools\N_m3u8DL-RE.exe
# TNT_DOWNLOAD_DIR=D:\Downloads\TNT
# N_m3u8DL mux (default mp4 + Shaka; mkv needs muxer=ffmpeg for EAC3)
# TNT_MUX_AFTER_DONE=format=mp4
# TNT_MUX_AFTER_DONE=format=mkv:muxer=ffmpeg
# TNT_USE_SHAKA_PACKAGER=0
# TNT_AUDIO_SELECT=best:for=best
# (default prefers AAC: codecs=mp4a:for=best)
# Keep playback dash.mpd (720p cap) instead of main.mpd
# TNT_MPD_RAW=1
# TNT_VIDEO_SELECT=res=1920*:for=best
# Segment 404: try TNT_PROXY_TUNNEL=127.0.0.1:7897 or TNT_DOWNLOAD_PROXY=0 (direct)
# TNT_TOKEN_FILE=custom-token.json
# Optional: override Discovery+ static key file (default: Discovery+ Keys.txt in project root)
# TNT_DISCOVERY_KEYS_FILE=Discovery+ Keys.txt
